    <!-- Texto anclado abajo a la izquierda -->
    <div class="hero-foto-texto">
      <span class="hero-etiqueta">Galería - 2016 ~ 2025</span>
      <h1 class="hero-titulo">Cada edición,<br>una historia.</h1>
      <p class="hero-bajada">53 fotografías - 8 ediciones - Cuenca, España</p>
    </div>

    <!-- Índice de años superpuesto abajo a la derecha -->
    <nav class="hero-indice" aria-label="Ir a año">
      <span class="hero-indice-label">Ediciones</span>
      <a href="#">2025</a>
      <a href="#y2024">2024</a>
      <a href="#y2023">2023</a>
      <a href="#y2021">2021</a>
      <a href="#y2020">2020</a>
      <a href="#y2019">2019</a>
      <a href="#y2017">2017</a>
      <a href="#y2016">2016</a>
