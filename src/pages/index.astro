---
import { EVENTO, EDICION } from '@/config/evento';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Contador from '@/components/Contador.astro';
import Patrocinadores from '@/components/Patrocinadores.astro';
import '@/styles/pages/index.css';
---

<BaseLayout
    title="Baja TT Cuenca"
    description="Web oficial de la Baja TT Cuenca, prueba puntuable del Campeonato Europeo FIA y del CERTT. Rally raid en la provincia de Cuenca, España."
    seccion="Inicio"
    activo="inicio"
    ogDescription="La prueba de rally raid más espectacular de Castilla-La Mancha forma parte del calendario europeo FIA desde 2026."
>
    <!-- HERO -->
    <section class="hero">
        <div class="hero-bg"></div>
        <div class="hero-overlay"></div>

        <!-- content -->
        <div class="hero-content">
            <div class="hero-left">
                <p class="hero-eyebrow">CUENCAMOTOR 4X4</p>
                <h1 class="hero-title">
                    Baja<br>
                    <span class="line-accent">TT</span><br>
                    Cuenca
                    <span class="line-thin">Club Deportivo</span>
                </h1>
            </div>
            <div class="hero-right">
                <div class="hero-badge">FIA European Cup {EVENTO.anio}</div>
                <a href="/inscripciones" class="hero-cta">
                    Inscribirse
                </a>
                <div class="hero-scroll">
                    <div class="scroll-line"></div>
                    Scroll
                </div>
            </div>
        </div>
    </section>

    <!-- PRÓXIMA EDICIÓN (se oculta sola durante y después del evento) -->
    <section class="proxima-edicion reveal" data-estado="antes">
        <h2 class="proxima-titulo">Próxima edición</h2>
        <Contador />
    </section>

    <!-- ABOUT -->
    <section class="about">
        <div class="about-img reveal">
            <img src="/img/noticias/1_Joan-Pedrero_Rallye-Cuenca_foto-K13Sport-1024x665.webp" alt="Imagen Joan Pedrero Rallye Cuenca - foto k13 sport" loading="lazy" />
        </div>
        <div class="about-text reveal">
            <p class="section-label">Club Deportivo Cuenca Motor 4×4</p>
            <h2 class="about-title">El rally<br>que <span>conquista</span><br>Europa</h2>
            <p class="about-body">
                El <strong>Club Deportivo Cuenca Motor 4×4</strong> organiza uno de los rallyes todoterreno más
                importantes de España. Desde 2016, la prueba recorre más de <strong>400 km de pistas forestales y
                    caminos rurales</strong> de la provincia de Cuenca, y desde 2026 forma parte del <strong>calendario
                    internacional FIA</strong>.
            </p>
            <a href="/nosotros" class="btn-ghost">
                <svg viewBox="0 0 24 24">
                    <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z" />
                </svg>
                Conoce el club
            </a>
        </div>
    </section>
    <!-- INSCRIPCIÓN CTA -->
    <section class="inscripcion-cta reveal">
        <div class="cta-left">
            <p class="cta-tag">Inscripciones abiertas</p>
            <h2 class="cta-title">Forma parte de la<br><span>Baja TT Cuenca</span></h2>
        </div>
        <div class="cta-right">
            <div class="cta-cats">
                <span class="cta-cat">FIA</span>
                <span class="cta-cat">CERTT</span>
                <span class="cta-cat">FIM Europe</span>
                <span class="cta-cat">Rally Raid</span>
            </div>
            <a href="/inscripciones" class="btn-inscripcion">
                Ver inscripciones
            </a>
        </div>
    </section>

    <!-- MULTIMEDIA -->
    <section class="multimedia">
        <div class="multimedia-text reveal">
            <p class="section-label">Galería</p>
            <h2 class="multimedia-title">Vive el<br><span>rally</span><br>desde dentro</h2>
            <p class="multimedia-desc">Imágenes y vídeos exclusivos de nuestros eventos. Adrenalina, paisaje y
                competición en estado puro.</p>
            <a href="/multimedia" class="btn-ghost">
                <svg viewBox="0 0 24 24">
                    <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z" />
                </svg>
                Ver galería completa
            </a>
        </div>
        <div class="multimedia-mosaic">
            <div class="mosaic-img">
                <img src="/img/noticias/1_empieza-Rallye-TT-Cuenca_-foto-kike-belenguer-cuenca-noticiaweb-1024x683.webp" loading="lazy" alt="Empieza el rallye TT Cuenca - Foto de Kike Belenguer">
            </div>
            <div class="mosaic-img">
                <img src="/img/noticias/1_Carnicer-ganador-Prologo-Cuenca-foto-K13-sport_4-octubre-2024-1024x576.webp" loading="lazy" alt="Carnicer ganador prólogo cuenca - foto k13 sport">
            </div>
            <div class="mosaic-img">
                <img src="/img/noticias/teniente-coronel-maría-jesús-pascual-ruiz_rallye-tt-cuenca.webp" loading="lazy" alt="Teniente coronel María Jesús Pascual Ruiz Rallye TT Cuenca">
            </div>
        </div>
    </section>

    <!-- NOTICIAS -->
    <section class="noticias-section">
        <div class="section-header">
            <h2>Últimas noticias</h2>
            <div class="section-line"></div>
            <a href="/noticias" class="section-link">Ver todas
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
            </a>
        </div>
        <div class="noticias-grid">
            <a href="/noticias/2025/josep-pedro-ha-ganado-el-xi-rallye-tt-cuenca" class="noticia-card reveal">
                <div class="noticia-img">
                    <picture>
                        <source media="(max-width: 600px)" srcset="/img/miniatura-noticias/2_josep-pedro-gana-el-xi-rallye-de-cuenca_2025_foto-k13-sport_-resized.webp">
                        <img src="/img/noticias/2_josep-pedro-gana-el-xi-rallye-de-cuenca_2025_foto-k13-sport_-931x1024.webp" alt="Josep Pedró ganador del XI RALLYE TT DE CUENCA">
                    </picture>
                </div>
                <div class="noticia-body">
                    <p class="noticia-meta">06.10.25 - <span>Ganador</span></p>
                    <h3 class="noticia-title">Josep Pedró gana el XI Rallye TT Cuenca</h3>
                    <div class="noticia-arrow">Leer más 
                        →
                    </div>
                </div>
            </a>
            <a href="/noticias/2025/luis-recuenco-gana-el-xi-rallye-tt-de-cuenca" class="noticia-card reveal">
                <div class="noticia-img">
                    <picture>
                        <source media="(max-width: 600px)" srcset="/img/miniatura-noticias/1_201_luis-recuenco_toyota_foto-k13-sport_20251004-_1fm7029-resized.webp">
                        <img src="/img/noticias/1_201_Luis-Recuenco_Toyota_FOTO-K13-SPORT_20251004-_1FM7029-1024x683.webp" alt="Luis Recuenco ganador del XI RALLYE TT DE CUENCA">
                    </picture>
                </div>
                <div class="noticia-body">
                    <p class="noticia-meta">04.10.25 - <span>Ganador</span></p>
                    <h3 class="noticia-title">Luis Recuenco gana el XI Rallye TT de Cuenca</h3>
                    <div class="noticia-arrow">Leer más 
                        →
                    </div>
                </div>
            </a>
            <a href="/noticias/2025/jose-m-reyes-ha-ganado-la-etapa-super-especial-con-un-brillante-recorrido" class="noticia-card reveal">
                <div class="noticia-img">
                    <picture>
                        <source media="(max-width: 600px)" srcset="/img/miniatura-noticias/josé-maria-reyes-gonzález_gana-la-prologo-foto-k13-sport_031025-resized.webp">
                        <img src="/img/noticias/José-Maria-Reyes-González_gana-la-prologo-FOTO-K13-SPORT_031025.jpg" alt="Jose M. Reyes ganador de la etapa super especial del Rallye de Cuenca">
                    </picture>
                </div>
                <div class="noticia-body">
                    <p class="noticia-meta">03.10.25 - <span>Ganador</span></p>
                    <h3 class="noticia-title">Jose M. Reyes gana la etapa súper especial</h3>
                    <div class="noticia-arrow">Leer más 
                        →
                    </div>
                </div>
            </a>
            <a href="/noticias/2025/un-rapidisimo-javier-vega-ha-ganado-la-etapa-super-especial-del-rallye-de-cuenca" class="noticia-card reveal">
                <div class="noticia-img">
                    <picture>
                        <source media="(max-width: 600px)" srcset="/img/miniatura-noticias/7_javier-vega-vence-la-super-especial_foto-k13-sport_-1-resized.webp">
                        <img src="/img/noticias/7_Javier-Vega-vence-la-Super-Especial_foto-K13-SPORT_-1-1024x720.webp" alt="Javier Vega ganador de la etapa super especial del Rallye de Cuenca">
                    </picture>
                </div>
                <div class="noticia-body">
                    <p class="noticia-meta">03.10.25 - <span>Ganador</span></p>
                    <h3 class="noticia-title">Javier Vega gana la súper especial del Rallye de Cuenca</h3>
                    <div class="noticia-arrow">Leer más 
                        →
                    </div>
                </div>
            </a>
        </div>
    </section>

    <!-- PATROCINADORES -->
    <Patrocinadores />
</BaseLayout>
