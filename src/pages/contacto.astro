---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Patrocinadores from '@/components/Patrocinadores.astro';
import Contador from '@/components/Contador.astro';
import { EVENTO, SITIO } from '@/config/evento';
import '@/styles/pages/contacto.css';

// Temas de contacto: rellenan el asunto del formulario al pulsarlos.
// "enlace" muestra un acceso directo a la página relacionada.
const temas = [
    {
        asunto: 'Inscripciones y participación',
        titulo: 'Inscripciones',
        texto: 'Dudas sobre categorías, plazos o documentación para participar.',
        enlace: { href: '/inscripciones', texto: 'Ver inscripciones' },
        icono: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM9 16l2 2 4-4',
    },
    {
        asunto: 'Patrocinio y colaboración',
        titulo: 'Patrocinio',
        texto: 'Haz que tu marca forme parte de la Baja TT Cuenca.',
        enlace: { href: '/patrocinadores', texto: 'Ver patrocinadores' },
        icono: 'M12 2l3 6.5 7 .9-5.1 4.8 1.3 6.8L12 17.8 5.8 21l1.3-6.8L2 9.4l7-.9z',
    },
    {
        asunto: 'Prensa y medios',
        titulo: 'Prensa',
        texto: 'Acreditaciones, notas de prensa y material para medios.',
        enlace: { href: '/prensa', texto: 'Zona de prensa' },
        icono: 'M4 4h13a1 1 0 0 1 1 1v14a2 2 0 0 0 2 2H6a2 2 0 0 1-2-2zM18 8h2a1 1 0 0 1 1 1v10a2 2 0 0 1-2 2M8 8h6M8 12h6M8 16h4',
    },
    {
        asunto: 'Voluntariado',
        titulo: 'Voluntariado',
        texto: 'Vive el rally desde dentro ayudando a la organización.',
        icono: 'M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z',
    },
    {
        asunto: 'Información general',
        titulo: 'Información general',
        texto: 'Horarios, zonas de público, alojamiento o cualquier otra duda.',
        icono: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 16v-4M12 8h.01',
    },
];
---

<BaseLayout
    title="Contacto | Baja TT Cuenca"
    description="Contacta con el Club Deportivo Cuenca Motor 4x4, organizadores de la Baja TT Cuenca. Email, redes sociales y formulario directo."
    seccion="Contacto"
    activo="contacto"
    ogTitle="Contacto - Baja TT Cuenca"
    ogDescription="Ponte en contacto con el equipo organizador de la Baja TT Cuenca. Estamos disponibles por email y redes sociales."
>
    <!-- HERO -->
    <section class="hero">
        <img class="hero-fondo" src="/img/heroContacto.webp" alt="" />
        <div class="hero-contenido">
            <div class="hero-left">
                <p class="hero-tag">Baja TT Cuenca - Club Cuenca Motor 4×4</p>
                <h1>Habla<br>con <em>nosotros</em></h1>
                <p class="hero-sub">Escríbenos por email, síguenos en redes o usa el formulario. Respondemos lo antes
                    posible.</p>
            </div>

            <!-- Contacto rápido -->
            <div class="hero-rapido">
                <p class="info-label">Email directo</p>
                <a class="email-link" href={`mailto:${SITIO.email}`}>{SITIO.email}</a>
                <button class="btn-copiar" type="button" data-email={SITIO.email}>
                    <svg viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
                    <span>Copiar email</span>
                </button>

                <p class="info-label">Redes sociales</p>
                <div class="redes">
                    <a class="red" href="https://www.instagram.com/cuencamotor4x4/" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37zM17.5 6.5h.01" /></svg>
                        <span>@cuencamotor4x4</span>
                    </a>
                    <a class="red" href="https://www.facebook.com/p/Rallye-TT-Cuenca-100063715416500/" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg>
                        <span>Rallye TT Cuenca</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- CUENTA ATRÁS -->
    <section class="cuenta-atras" data-estado="antes">
        <div class="ca-texto">
            <p class="ca-tag">
                <span class="ca-punto"></span>
                <span class="ca-solo-antes">Próxima edición</span>
                <span class="ca-solo-durante">En directo</span>
                <span class="ca-solo-despues">Edición {EVENTO.anio} finalizada</span>
            </p>
            <h2 class="ca-titulo">
                <span class="ca-solo-antes">Baja TT Cuenca <em>{EVENTO.anio}</em></span>
                <span class="ca-solo-durante">¡La carrera está <em>en marcha</em>!</span>
                <span class="ca-solo-despues">¡Gracias por <em>vivirlo</em>!</span>
            </h2>
            <p class="ca-fechas">
                <span class="ca-solo-antes ca-solo-durante">{EVENTO.fechas}</span>
                <span class="ca-solo-despues">Nos vemos en {EVENTO.anio + 1}</span>
            </p>
        </div>

        <Contador />

        {SITIO.youtube
            ? <a class="ca-cta ca-solo-durante" href={SITIO.youtube} target="_blank" rel="noopener">Ver en directo →</a>
            : <a class="ca-cta ca-solo-durante" href="/noticias">Sigue la carrera →</a>}
        <a class="ca-cta ca-solo-despues" href="/noticias">Ver crónicas y resultados →</a>
    </section>

    <!-- TEMAS -->
    <section class="temas">
        <div class="section-header">
            <h2>¿Sobre qué quieres hablar?</h2>
            <div class="section-line"></div>
        </div>
        <div class="temas-grid">
            {temas.map((t, i) => (
                <article class="tema reveal" style={`transition-delay:${i * 0.06}s`}>
                    <div class="tema-cabecera">
                        <svg class="tema-icono" viewBox="0 0 24 24"><path d={t.icono} /></svg>
                        {t.enlace && <a class="tema-enlace" href={t.enlace.href}>{t.enlace.texto} ↗</a>}
                    </div>
                    <h3>{t.titulo}</h3>
                    <p>{t.texto}</p>
                    <button class="tema-btn" type="button" data-asunto={t.asunto}>
                        Escribir
                        <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
                    </button>
                </article>
            ))}
        </div>
    </section>

    <!-- FORMULARIO -->
    <section class="form-seccion" id="formulario">
        <div class="form-intro reveal">
            <p class="hero-tag">Formulario</p>
            <h2 class="form-title">Envíanos<br>un <em>mensaje</em></h2>
            <p class="form-subtitle">Tu mensaje llegará directamente a nuestro equipo. Al enviarlo se abrirá tu
                cliente de correo con los datos rellenados.</p>
        </div>

        <form class="formulario reveal" id="formContacto" novalidate data-email={SITIO.email}>
            <div class="fgrid">
                <div class="fg">
                    <label for="nombre">Nombre *</label>
                    <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required />
                    <span class="fg-error">Introduce tu nombre.</span>
                </div>
                <div class="fg">
                    <label for="telefono">Teléfono</label>
                    <input type="tel" id="telefono" name="telefono" placeholder="+34 600 000 000" />
                </div>
                <div class="fg full">
                    <label for="email">Email *</label>
                    <input type="email" id="email" name="email" placeholder="tu@email.com" required />
                    <span class="fg-error">Introduce un email válido.</span>
                </div>
                <div class="fg full">
                    <label for="asunto">Asunto</label>
                    <select id="asunto" name="asunto">
                        <option value="" disabled selected>Selecciona un tema…</option>
                        {temas.map(t => <option>{t.asunto}</option>)}
                        <option>Otro</option>
                    </select>
                </div>
                <div class="fg full">
                    <label for="mensaje">Mensaje *</label>
                    <textarea id="mensaje" name="mensaje" placeholder="Escribe tu mensaje aquí…" required></textarea>
                    <span class="fg-error">Escribe tu mensaje.</span>
                </div>
            </div>
            <div class="form-footer">
                <button class="btn-send" type="submit">
                    Enviar mensaje
                    <svg viewBox="0 0 24 24"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z" /></svg>
                </button>
                <p class="send-ok" role="status" hidden>
                    Abriendo tu correo… Si no se abre, escríbenos a <a href={`mailto:${SITIO.email}`}>{SITIO.email}</a>.
                </p>
            </div>
        </form>
    </section>

    <!-- PATROCINADORES -->
    <Patrocinadores />

<script>
    // Copiar el email al portapapeles
    const btnCopiar = document.querySelector<HTMLButtonElement>('.btn-copiar');
    btnCopiar?.addEventListener('click', async () => {
        const texto = btnCopiar.querySelector('span')!;
        try {
            await navigator.clipboard.writeText(btnCopiar.dataset.email!);
            texto.textContent = '¡Copiado!';
        } catch {
            texto.textContent = 'No se pudo copiar';
        }
        btnCopiar.classList.add('copiado');
        setTimeout(() => {
            texto.textContent = 'Copiar email';
            btnCopiar.classList.remove('copiado');
        }, 2000);
    });

    // Los temas rellenan el asunto y bajan al formulario
    const form = document.getElementById('formContacto') as HTMLFormElement;
    const asunto = form.querySelector<HTMLSelectElement>('#asunto')!;
    document.querySelectorAll<HTMLButtonElement>('.tema-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            asunto.value = btn.dataset.asunto!;
            document.getElementById('formulario')!.scrollIntoView({ behavior: 'smooth' });
            form.querySelector<HTMLInputElement>('#nombre')!.focus({ preventScroll: true });
        });
    });

    // Validación en línea y envío por mailto
    const campos = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]');
    const validar = (campo: HTMLInputElement | HTMLTextAreaElement) => {
        const ok = campo.checkValidity() && campo.value.trim() !== '';
        campo.closest('.fg')!.classList.toggle('invalido', !ok);
        campo.setAttribute('aria-invalid', String(!ok));
        return ok;
    };
    campos.forEach(c => c.addEventListener('blur', () => validar(c)));

    form.addEventListener('submit', e => {
        e.preventDefault();
        const invalidos = [...campos].filter(c => !validar(c));
        if (invalidos.length) {
            invalidos[0].focus();
            return;
        }
        const datos = new FormData(form);
        const telefono = datos.get('telefono') ? `\nTeléfono: ${datos.get('telefono')}` : '';
        const body = encodeURIComponent(`Nombre: ${datos.get('nombre')}\nEmail: ${datos.get('email')}${telefono}\n\n${datos.get('mensaje')}`);
        const tema = encodeURIComponent(String(datos.get('asunto') || 'Contacto web'));
        form.querySelector<HTMLElement>('.send-ok')!.hidden = false;
        window.location.href = `mailto:${form.dataset.email}?subject=${tema}&body=${body}`;
    });
</script>
</BaseLayout>
