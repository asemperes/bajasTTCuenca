---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Patrocinadores from '@/components/Patrocinadores.astro';
import '@/styles/pages/noticia.css';
---

<BaseLayout
    title="NOMINADO PREMIO AL MEJOR EVENTO DEPORTIVO - Baja TT Cuenca"
    description="Nominado: Rally TT Cuenca – Cada edición supera a la anterior, tanto en nivel de pilotos como en número de aficionados. Es habitual en el calendario del Campeonato de España de Rallyes Todoterreno. ¡Deja tu me gusta para votar por ellos y comparte esta publicación para que much@s..."
    seccion="Noticias"
    activo="noticias"
    ogTitle="NOMINADO PREMIO AL MEJOR EVENTO DEPORTIVO"
    ogImage="/img/noticias/1_201_Luis-Recuenco_Toyota_FOTO-K13-SPORT_20251004-_1FM7029-1024x683.webp"
    ogType="article"
>
    <!-- HERO -->
    <div class="noticia-hero">
        <img src="https://cuencamotor4x4.com/wp-content/uploads/2023/09/WhatsApp-Image-2023-09-24-at-11.55.42-1.jpeg" alt="NOMINADO PREMIO AL MEJOR EVENTO DEPORTIVO">
        <div class="noticia-hero-overlay"></div>
        <div class="noticia-hero-content">
            <span class="noticia-tag">Noticias · 24 de septiembre de 2023</span>
            <h1 class="noticia-hero-titulo">NOMINADO PREMIO AL MEJOR EVENTO DEPORTIVO</h1>
            <div class="noticia-meta">
                <span>Cuenca Motor 4x4</span>
                <span class="noticia-meta-dot"></span>
                <span>24 de septiembre de 2023</span>
            </div>
        </div>
    </div>

    <!-- CUERPO -->
    <div class="noticia-body">
        <div class="noticia-breadcrumb">
            <a href="/">Inicio</a>
            <span class="noticia-breadcrumb-sep">›</span>
            <a href="/noticias">Noticias</a>
            <span class="noticia-breadcrumb-sep">›</span>
            <span>NOMINADO PREMIO AL MEJOR EVENTO DEPORTIVO</span>
        </div>

        <div class="noticia-divider"></div>

        <div class="noticia-contenido reveal">
            <p>Nominado: Rally TT Cuenca – Cada edición supera a la anterior, tanto en nivel de pilotos como en número de aficionados. Es habitual en el calendario del Campeonato de España de Rallyes Todoterreno.
¡Deja tu me gusta para votar por ellos y comparte esta publicación para que much@s más también lo hagan!
https://www.instagram.com/p/CxX0pQSRg2J/?igshid=MzRlODBiNWFlZA==
ACDCAwards #PremiosACDC #Cuenca #Deporte #EventoDeportivo</p>
        </div>

        <a href="/noticias" class="noticia-back">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
            Volver a noticias
        </a>
    </div>

    <!-- FOOTER -->

    <!-- PATROCINADORES -->
    <Patrocinadores />
</BaseLayout>
