    activo="noticias"
    ogTitle="RUBÉN SALDAÑA GANA CON AUTORIDAD LA ULTIMA PRUEBA DEL CAMPEONATO DE ESPAÑA DE RAIDS TT"
    ogImage="/img/noticias/1_201_Luis-Recuenco_Toyota_FOTO-K13-SPORT_20251004-_1FM7029-1024x683.webp"
    ogType="article"
>
    <!-- HERO -->
    <div class="noticia-hero">
        <img src="https://cuencamotor4x4.com/wp-content/uploads/2023/10/1º_302_Rubén-Saldana_HUSQVARNA-DSC0091-1024x616.jpg" alt="RUBÉN SALDAÑA GANA CON AUTORIDAD LA ULTIMA PRUEBA DEL CAMPEONATO DE ESPAÑA DE RAIDS TT">
        <div class="noticia-hero-overlay"></div>
        <div class="noticia-hero-content">
            <span class="noticia-tag">Noticias · 26 de octubre de 2023</span>
            <h1 class="noticia-hero-titulo">RUBÉN SALDAÑA GANA CON AUTORIDAD LA ULTIMA PRUEBA DEL CAMPEONATO DE ESPAÑA DE RAIDS TT</h1>
            <div class="noticia-meta">
