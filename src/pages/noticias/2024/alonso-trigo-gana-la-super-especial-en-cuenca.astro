---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Patrocinadores from '@/components/Patrocinadores.astro';
import '@/styles/pages/noticia.css';
---

<BaseLayout
    title="ALONSO TRIGO, GANA LA SÚPER ESPECIAL EN CUENCA. - Baja TT Cuenca"
    description="El madrileño Alonso Trigo, con KTM\r\n            450 EXC, acaba de ganar la Etapa Super Especial del Campeonato de España de Raids TT\r\n            que se está celebrando en Cuenca.\r\n            En segunda posición ha llegado Javier Vega,\r\n            el líder provisional del Nacional con su YamahaWR450 Rallye. Y el te..."
    seccion="Noticias"
    activo="noticias"
    ogTitle="ALONSO TRIGO, GANA LA SÚPER ESPECIAL EN CUENCA."
    ogType="article"
>
    <!-- HERO -->
    <div class="noticia-hero">
        <img src="/img/noticias/1-Trigo-vencedor-Super-Especial-fotoK13-sport-1024x683.jpg"
            alt="ALONSO TRIGO, GANA LA SÚPER ESPECIAL EN CUENCA.">
        <div class="noticia-hero-overlay"></div>
        <div class="noticia-hero-content">
            <span class="noticia-tag">Noticias · 4 de octubre de 2024</span>
            <h1 class="noticia-hero-titulo">ALONSO TRIGO, GANA LA SÚPER ESPECIAL EN CUENCA</h1>
            <div class="noticia-meta">
                <span>Cuenca Motor 4x4</span>
                <span class="noticia-meta-dot"></span>
                <span>4 de octubre de 2024</span>
            </div>
        </div>
    </div>

    <!-- CUERPO -->
    <div class="noticia-body">
        <div class="noticia-breadcrumb">
            <a href="/">Inicio</a>
            <span class="noticia-breadcrumb-sep">›</span>
            <a href="/noticias">Noticias</a>
            <span class="noticia-breadcrumb-sep">›</span>
            <span>ALONSO TRIGO, GANA LA SÚPER ESPECIAL EN CUENCA.</span>
        </div>

        <div class="noticia-divider"></div>

        <div class="noticia-contenido reveal">
            <p>
                El madrileño Alonso Trigo, con KTM
                450 EXC, acaba de ganar la Etapa Super Especial del Campeonato de España de Raids TT
                que se está celebrando en Cuenca.
                En segunda posición ha llegado Javier Vega,
                el líder provisional del Nacional con su YamahaWR450 Rallye. Y el tercer puesto
                ha sido para Juan
                Pedrero García con KTM.
                La
                carrera continua mañana sábado con dos Sectores Selectivos, donde los más de 60
                equipos tendrán por delante un recorrido de casi 400 kilómetros, de los que 300
                serán cronometrados.
                En
                esta cita se podrá disfrutar del mejor pilotaje de las categorías Enduro,
                Trail, Maxi Trail, Quad GPS y Moto GPS; pero sobre todo de la emoción por
                conocer quien será el Campeón de España de de Raids TT 2024.
            </p>
<div class="tabla-scroll">
                <table class="noticia-tabla">
                    <caption>Clasificación Etapa Súper Especial X Rallye TT Cuenca 2024</caption>
                    <thead>
                        <tr>
                            <th>Pos.</th>
                            <th>Piloto</th>
                            <th>Vehículo</th>
                            <th>Tiempo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="ganador">
                            <td>1 <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256"
                                    fill="currentColor">
                                    <path
                                        d="M216.71,99.73l-15.6,93.59a8,8,0,0,1-7.89,6.68H62.78a8,8,0,0,1-7.89-6.68L39.29,99.73l.08,0a19.82,19.82,0,0,0,9.22-4.16h0L88,144l32-73.65h0a20,20,0,0,0,15.92,0h0L168,144l39.39-48.48h0a19.82,19.82,0,0,0,9.22,4.16Z">
                                    </path>
                                    <path
                                        d="M248,80a28,28,0,1,0-51.12,15.77l-26.79,33L146,73.4a28,28,0,1,0-36.06,0L85.91,128.74l-26.79-33a28,28,0,1,0-26.6,12L47,194.63A16,16,0,0,0,62.78,208H193.22A16,16,0,0,0,209,194.63l14.47-86.85A28,28,0,0,0,248,80ZM128,40a12,12,0,1,1-12,12A12,12,0,0,1,128,40ZM24,80A12,12,0,1,1,36,92,12,12,0,0,1,24,80ZM193.22,192H62.78L48.86,108.52,81.79,149A8,8,0,0,0,88,152a7.83,7.83,0,0,0,1.08-.07,8,8,0,0,0,6.26-4.74l29.3-67.4a27,27,0,0,0,6.72,0l29.3,67.4a8,8,0,0,0,6.26,4.74A7.83,7.83,0,0,0,168,152a8,8,0,0,0,6.21-3l32.93-40.52ZM220,92a12,12,0,1,1,12-12A12,12,0,0,1,220,92Z">
                                    </path>
                                </svg></td>
                            <td>Alonso Trigo</td>
                            <td>KTM 450 EXC</td>
                            <td>5:25.4</td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>Javier Vega</td>
                            <td>Yamaha WR450 Rallye</td>
                            <td>5:44.5</td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>Juan Pedrero</td>
                            <td>KTM</td>
                            <td>5:45.8</td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>

        <a href="/noticias" class="noticia-back">
            <svg viewBox="0 0 24 24">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            Volver a noticias
        </a>
    </div>

    <!-- FOOTER -->

    <!-- PATROCINADORES -->
    <Patrocinadores />
</BaseLayout>
