    ogImage="/img/noticias/1_201_Luis-Recuenco_Toyota_FOTO-K13-SPORT_20251004-_1FM7029-1024x683.webp"
    ogType="article"
>
    <!-- HERO -->
    <div class="noticia-hero">
        <img src="/img/noticias/2_xi-reallye-tt-cuenca-2025_foto-k13-sport_baja-1024x683.webp" alt="RALLYE TT CUENCA, UNA INSCRIPCIÓN DE ALTURA CON MÁS DE 120 EQUIPOS">
