    seccion="Noticias"
    activo="noticias"
    ogTitle="COCHES, SSV Y MOTOS SE DARÁN CITA EN EL RALLYE TT DE CUENCA"
    ogImage="/img/noticias/1_201_Luis-Recuenco_Toyota_FOTO-K13-SPORT_20251004-_1FM7029-1024x683.webp"
    ogType="article"
>
    <!-- HERO -->
    <div class="noticia-hero">
        <img src="https://cuencamotor4x4.com/wp-content/uploads/2021/10/abierta-inscripciones-recuenco-mini.png" alt="COCHES, SSV Y MOTOS SE DARÁN CITA EN EL RALLYE TT DE CUENCA">
        <div class="noticia-hero-overlay"></div>
        <div class="noticia-hero-content">
            <span class="noticia-tag">Noticias · 5 de octubre de 2021</span>
            <h1 class="noticia-hero-titulo">COCHES, SSV Y MOTOS SE DARÁN CITA EN EL RALLYE TT DE CUENCA</h1>
            <div class="noticia-meta">
                <span>Cuenca Motor 4x4</span>
                <span class="noticia-meta-dot"></span>
