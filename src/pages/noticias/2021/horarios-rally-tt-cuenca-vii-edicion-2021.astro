---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Patrocinadores from '@/components/Patrocinadores.astro';
import '@/styles/pages/noticia.css';
---

<BaseLayout
    title="HORARIOS RALLY TT CUENCA VII EDICIÓN 2021 - Baja TT Cuenca"
    description="Publicados los horarios de la VII edición del Rally TT Cuenca. #RFEDA #CERTT #fcmm #Cuenca #motor #RALLYE #castillalamancha #CuencaVenYDisfruta #VIIRallyeTTCuenca #RallyeTTCuenca2021 #RallyeTTCuenca #Libro de ruta #CampeonatodeEspañaTT #AyuntamientodeCuenca #DiputacióndeCuenca #dipucu..."
    seccion="Noticias"
    activo="noticias"
    ogTitle="HORARIOS RALLY TT CUENCA VII EDICIÓN 2021"
    ogImage="/img/noticias/1_201_Luis-Recuenco_Toyota_FOTO-K13-SPORT_20251004-_1FM7029-1024x683.webp"
    ogType="article"
>
    <!-- HERO -->
    <div class="noticia-hero">
        <img src="https://cuencamotor4x4.com/wp-content/uploads/2021/10/horarios-rally-tt-cuenca-2021-1024x683.jpg" alt="HORARIOS RALLY TT CUENCA VII EDICIÓN 2021">
        <div class="noticia-hero-overlay"></div>
        <div class="noticia-hero-content">
            <span class="noticia-tag">Noticias · 16 de octubre de 2021</span>
            <h1 class="noticia-hero-titulo">HORARIOS RALLY TT CUENCA VII EDICIÓN 2021</h1>
            <div class="noticia-meta">
                <span>Cuenca Motor 4x4</span>
                <span class="noticia-meta-dot"></span>
                <span>16 de octubre de 2021</span>
            </div>
        </div>
    </div>

    <!-- CUERPO -->
    <div class="noticia-body">
        <div class="noticia-breadcrumb">
            <a href="/">Inicio</a>
            <span class="noticia-breadcrumb-sep">›</span>
            <a href="/noticias">Noticias</a>
            <span class="noticia-breadcrumb-sep">›</span>
            <span>HORARIOS RALLY TT CUENCA VII EDICIÓN 2021</span>
        </div>

        <div class="noticia-divider"></div>

        <div class="noticia-contenido reveal">
            <p>Publicados los horarios de la VII edición del Rally TT Cuenca.
#RFEDA
#CERTT
#fcmm
#Cuenca
#motor
#RALLYE
#castillalamancha
#CuencaVenYDisfruta
#VIIRallyeTTCuenca
#RallyeTTCuenca2021
#RallyeTTCuenca
#Libro de ruta
#CampeonatodeEspañaTT
#AyuntamientodeCuenca
#DiputacióndeCuenca
#dipucuenca
#apoyandoeldeporte
#JCCM
#GOBJCCM
#RFDEA
#
cuencamotor4x4.com
#ACDCuenca
@RFDEA
@campeonatott
@AyuntamientodeCuenca @DiputaciondeCuenca
@dipucuenca
@gobjccm
@JCCM
@acdcuenca
@kikebelenguer</p>
        </div>

        <a href="/noticias" class="noticia-back">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
            Volver a noticias
        </a>
    </div>

    <!-- FOOTER -->

    <!-- PATROCINADORES -->
    <Patrocinadores />
</BaseLayout>
