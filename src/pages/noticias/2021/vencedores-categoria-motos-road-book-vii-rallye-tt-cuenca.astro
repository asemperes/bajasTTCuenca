---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Patrocinadores from '@/components/Patrocinadores.astro';
import '@/styles/pages/noticia.css';
---

<BaseLayout
    title="VENCEDORES CATEGORÍA MOTOS ROAD BOOK – VII RALLYE TT CUENCA - Baja TT Cuenca"
    description="1 – Alberto Martín. 2 – Javier Veg. 3 – Rubén Saldaña. #rallyettcuenca2021 #RFEDA #CERTT #fcmm #Cuenca #Motor #RALLYE #castillalamancha #CuencaVenYDisfruta #VIIRallyeTTCuenca #RallyeTTCuenca2021 #RallyeTTCuenca #Roadbook #CampeonatodeEspañaTT #AyuntamientodeCuenca #Diputaci..."
    seccion="Noticias"
    activo="noticias"
    ogTitle="VENCEDORES CATEGORÍA MOTOS ROAD BOOK – VII RALLYE TT CUENCA"
    ogImage="/img/noticias/1_201_Luis-Recuenco_Toyota_FOTO-K13-SPORT_20251004-_1FM7029-1024x683.webp"
    ogType="article"
>
    <!-- HERO -->
    <div class="noticia-hero">
        <img src="https://cuencamotor4x4.com/wp-content/uploads/2021/10/premios-Motos-Road-Book-VII-Rally-TT-Cuenca.jpg" alt="VENCEDORES CATEGORÍA MOTOS ROAD BOOK – VII RALLYE TT CUENCA">
        <div class="noticia-hero-overlay"></div>
        <div class="noticia-hero-content">
            <span class="noticia-tag">Noticias · 24 de octubre de 2021</span>
            <h1 class="noticia-hero-titulo">VENCEDORES CATEGORÍA MOTOS ROAD BOOK – VII RALLYE TT CUENCA</h1>
            <div class="noticia-meta">
                <span>Cuenca Motor 4x4</span>
                <span class="noticia-meta-dot"></span>
                <span>24 de octubre de 2021</span>
            </div>
        </div>
    </div>

    <!-- CUERPO -->
    <div class="noticia-body">
        <div class="noticia-breadcrumb">
            <a href="/">Inicio</a>
            <span class="noticia-breadcrumb-sep">›</span>
            <a href="/noticias">Noticias</a>
            <span class="noticia-breadcrumb-sep">›</span>
            <span>VENCEDORES CATEGORÍA MOTOS ROAD BOOK – VII RALLYE TT CUENCA</span>
        </div>

        <div class="noticia-divider"></div>

        <div class="noticia-contenido reveal">
            <p>1 – Alberto Martín.
2 – Javier Veg.
3 – Rubén Saldaña.
#rallyettcuenca2021 #RFEDA #CERTT #fcmm #Cuenca #Motor #RALLYE #castillalamancha #CuencaVenYDisfruta #VIIRallyeTTCuenca #RallyeTTCuenca2021 #RallyeTTCuenca #Roadbook #CampeonatodeEspañaTT #AyuntamientodeCuenca #DiputaciondeCuenca #dipucuenca #apoyandoeldeporte #JCCM #GOBJCCM #RFDEA #cuencamotor4x4.com #frivall #globalcaja #globalcajaconeldeporte #globalcajaconeldeporteconquense #ACDCuenca @RFDEA @campeonatott @AyuntamientodeCuenca @DiputaciondeCuenca @f_globalcaja_cu @dipucuenca @gobjccm @JCCM @acdcuenca @kikebelenguer</p>
        </div>

        <a href="/noticias" class="noticia-back">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
            Volver a noticias
        </a>
    </div>

    <!-- FOOTER -->

    <!-- PATROCINADORES -->
    <Patrocinadores />
</BaseLayout>
