---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Patrocinadores from '@/components/Patrocinadores.astro';
import '@/styles/pages/noticia.css';
---

<BaseLayout
    title="CARTEL OFICIAL VII RALLYE TT CUENCA - Baja TT Cuenca"
    description="¡ ¡ Ya tenemos cartel oficial del VII Rallye TT Cuenca ! ! Comienza la cuenta atrás… 22, 23 y 24 de Octubre. Síguenos en nuestras redes sociales para mantenerte informado. #RFEDA #CERTT #fcmm #Cuenca #Motor #RALLYE #castillalamancha #CuencaVenYDisfruta #VIIRallyeTTCuenca #RallyeT..."
    seccion="Noticias"
    activo="noticias"
    ogTitle="CARTEL OFICIAL VII RALLYE TT CUENCA"
    ogImage="/img/noticias/1_201_Luis-Recuenco_Toyota_FOTO-K13-SPORT_20251004-_1FM7029-1024x683.webp"
    ogType="article"
>
    <!-- HERO -->
    <div class="noticia-hero">
        <img src="https://cuencamotor4x4.com/wp-content/uploads/2021/10/cartel-oficial-imagen-inicio.jpg" alt="CARTEL OFICIAL VII RALLYE TT CUENCA">
        <div class="noticia-hero-overlay"></div>
        <div class="noticia-hero-content">
            <span class="noticia-tag">Noticias · 7 de octubre de 2021</span>
            <h1 class="noticia-hero-titulo">CARTEL OFICIAL VII RALLYE TT CUENCA</h1>
            <div class="noticia-meta">
                <span>Cuenca Motor 4x4</span>
                <span class="noticia-meta-dot"></span>
                <span>7 de octubre de 2021</span>
            </div>
        </div>
    </div>

    <!-- CUERPO -->
    <div class="noticia-body">
        <div class="noticia-breadcrumb">
            <a href="/">Inicio</a>
            <span class="noticia-breadcrumb-sep">›</span>
            <a href="/noticias">Noticias</a>
            <span class="noticia-breadcrumb-sep">›</span>
            <span>CARTEL OFICIAL VII RALLYE TT CUENCA</span>
        </div>

        <div class="noticia-divider"></div>

        <div class="noticia-contenido reveal">
            <p>¡ ¡ Ya tenemos cartel oficial del VII Rallye TT Cuenca ! !
Comienza la cuenta atrás… 22, 23 y 24 de Octubre. Síguenos en nuestras redes sociales para mantenerte informado.
#RFEdA #CERTT #fcmm #Cuenca #Motor #RALLYE #castillalamancha #CuencaVenYDisfruta #VIIRallyeTTCuenca #RallyeTTCuenca2021 #RallyeTTCuenca #Roadbook #CampeonatodeEspañaTT #AyuntamientodeCuenca #DiputaciondeCuenca #dipucuenca #apoyandoeldeporte #JCCM #GOBJCCM #RFDEA #
cuencamotor4x4.com
#ACDCuenca @RFDEA @campeonatott @AyuntamientodeCuenca @DiputaciondeCuenca @dipucuenca @gobjccm @JCCM @acdcuenca</p>
        </div>

        <a href="/noticias" class="noticia-back">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
            Volver a noticias
        </a>
    </div>

    <!-- FOOTER -->

    <!-- PATROCINADORES -->
    <Patrocinadores />
</BaseLayout>
