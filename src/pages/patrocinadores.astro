---
import { EVENTO } from '@/config/evento';
import { categorias } from '@/data/patrocinadores';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/pages/patrocinadores.css';

const total = categorias.reduce((suma, c) => suma + c.patrocinadores.length, 0);
// Logos que desfilan en la cinta del hero (solo los que tienen enlace)
const cinta = categorias.flatMap(c => c.patrocinadores).filter(p => p.url && !p.clase);
---

<BaseLayout
    title="Patrocinadores | Baja TT Cuenca"
    description={`Patrocinadores y colaboradores oficiales de la Baja TT Cuenca ${EVENTO.anio}. Instituciones y empresas que hacen posible el evento.`}
    seccion="Patrocinadores"
    activo="patrocinadores"
    ogTitle="Patrocinadores - Baja TT Cuenca"
    ogDescription="Conoce a los patrocinadores y colaboradores que hacen posible la Baja TT Cuenca cada año."
>
  <!-- HERO -->
  <header class="hero">
    <div class="hero-body" style={`--anio: '${EVENTO.anio}'`}>
      <div class="hero-texto">
        <span class="hero-overline">Partners - Baja TT Cuenca {EVENTO.anio}</span>
        <h1 class="hero-title">
          Patrocinadores<br>
          y <span class="color-titulo">colaboradores</span>
        </h1>
        <p class="hero-desc">
          El rally es posible gracias al trabajo conjunto de instituciones públicas, marcas del motor y tejido
          empresarial local. Esta red de apoyo impulsa el deporte, el territorio y la proyección de Cuenca.
        </p>
        <a href="/contacto" class="hero-cta">
          Quiero patrocinar
          <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
      </div>

      <!-- Índice de categorías con el número real de partners -->
      <nav class="hero-indice" aria-label="Categorías de patrocinadores">
        <div class="indice-total">
          <span class="stat-num">{total}</span>
          <span class="stat-label">Partners en total</span>
        </div>
        {categorias.map(c => (
          <a href={`#${c.id}`} class="indice-item">
            <span class="indice-num">{c.patrocinadores.length}</span>
            <span class="indice-nombre">{c.titulo}</span>
            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
          </a>
        ))}
      </nav>
    </div>

    <!-- Cinta de logos -->
    <div class="hero-cinta" aria-hidden="true">
      <div class="cinta-pista">
        {[...cinta, ...cinta].map(p => (
          <span class="cinta-logo"><img src={p.logo} alt="" loading="lazy"></span>
        ))}
      </div>
    </div>
  </header>

  <!-- CONTENIDO -->
  <main class="sponsors-page">
    {categorias.map(c => (
      <section class="sponsors-category" id={c.id}>
        <div class="cat-sidebar">
          <h2 class="cat-name">{c.titulo}</h2>
          <div class="cat-line"></div>
          <p class="cat-desc">{c.descripcion}</p>
          <a class="cat-back" href="#">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 256 256"><path d="M205.66,117.66a8,8,0,0,1-11.32,0L136,59.31V216a8,8,0,0,1-16,0V59.31L61.66,117.66a8,8,0,0,1-11.32-11.32l72-72a8,8,0,0,1,11.32,0l72,72A8,8,0,0,1,205.66,117.66Z"></path></svg>
            Volver arriba</a>
        </div>
        <div class={`sponsors-grid reveal grid-${c.id}`}>
          {c.patrocinadores.map(p => p.url ? (
            <a class:list={['sponsor-card', p.clase]} href={p.url} target="_blank" rel="noopener" title={p.nombre}>
              <img src={p.logo} alt={p.alt} loading="lazy">
            </a>
          ) : (
            <span class:list={['sponsor-card', p.clase]} title={p.nombre}>
              <img src={p.logo} alt={p.alt} loading="lazy">
            </span>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>
