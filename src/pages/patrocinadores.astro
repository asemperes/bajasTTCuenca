          <img src="/img/logosPatros/ayuntamiento-cuenca-logo.webp" alt="Ayuntamiento de Cuenca">
        </a>
        <a class="sponsor-card" href="https://villardeolalla.com/" target="_blank" rel="noopener" title="Ayuntamiento de Villar de Olalla">
          <img src="/img/logosPatros/ayuntamiento-villar-de-olalla.webp" alt="Ayuntamiento Villar de Olalla">
