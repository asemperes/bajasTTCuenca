          Volver arriba</a>
      </div>
      <div class="sponsors-grid reveal grid-institucional">

        <a class="sponsor-card" href="https://www.castillalamancha.es/" target="_blank" rel="noopener" title="Junta de Castilla-La Mancha">
          <img src="/img/logosPatros/jccm-logo.webp" alt="Junta CLM">
        </a>
        <a class="sponsor-card" href="https://www.turismocastillalamancha.es/" target="_blank" rel="noopener" title="Turismo Castilla-La Mancha">
          <img src="/img/logosPatros/castilla-la-mancha.webp" alt="Turismo CLM">
        </a>
