---
import { EVENTO, EDICION } from '@/config/evento';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/pages/patrocinadores.css';
---

<BaseLayout
    title="Patrocinadores | Baja TT Cuenca"
    description={`Patrocinadores y colaboradores oficiales de la Baja TT Cuenca ${EVENTO.anio}. Instituciones y empresas que hacen posible el evento.`}
    seccion="Patrocinadores"
    activo="patrocinadores"
    ogTitle="Patrocinadores - Baja TT Cuenca"
    ogDescription="Conoce a los patrocinadores y colaboradores que hacen posible la Baja TT Cuenca cada año."
>
  <!-- HERO -->
  <header class="hero">

    <div class="hero-body">
      <span class="hero-overline">Partners - Baja TT Cuenca</span>
      <h1 class="hero-title">
        Patrocinadores<br>
        y <span class="color-titulo">colaboradores</span>
      </h1>
      <p class="hero-desc">
        El rally es posible gracias al trabajo conjunto de instituciones públicas, marcas del motor y tejido
        empresarial local. Esta red de apoyo impulsa el deporte, el territorio y la proyección de Cuenca.
      </p>
      <div class="hero-bottom">
        <div class="hero-stat">
          <span class="stat-num">50+</span>
          <span class="stat-label">Partners</span>
        </div>
      </div>
    </div>
  </header>

  <!-- CONTENIDO -->
  <main class="sponsors-page">

    <!-- 01 INSTITUCIONAL -->
