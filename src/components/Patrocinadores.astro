---
import '@/styles/components/patrocinadores.css';
---

<section class="patrocinadores-section reveal">
    <div class="section-header">
        <h2>Patrocinadores</h2>
        <div class="section-line"></div>
        <a href="/patrocinadores" class="section-link">Ver todos
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
        </a>
    </div>
    <div class="patros-grid">
        <div class="patro-item"><a href="https://ayuntamiento.cuenca.es/" target="_blank"><img src="/img/logosPatros/ayuntamiento-cuenca-logo.webp" alt="Ayuntamiento de Cuenca"></a></div>
        <div class="patro-item"><a href="https://villardeolalla.com/" target="_blank"><img src="/img/logosPatros/ayuntamiento-villar-de-olalla.webp" alt="Ayuntamiento Villar de Olalla"></a>
        </div>
        <div class="patro-item"><a href="https://certt.rfeda.es/" target="_blank"><img src="/img/logosPatros/certt-cubo.webp" alt="CERTT"></a></div>
        <div class="patro-item"><a href="https://www.csd.gob.es" target="_blank"><img src="/img/logosPatros/consejo-superior-de-deportes.webp" alt="Consejo Superior de Deportes"></a>
        </div>
        <div class="patro-item"><a href="https://www.dipucuenca.es" target="_blank"><img src="/img/logosPatros/diputacion-cuenca.webp" alt="Diputación de Cuenca"></a></div>
        <div class="patro-item"><a href="https://www.facm.es" target="_blank"><img src="/img/logosPatros/facm.webp" alt="FACM"></a></div>
        <div class="patro-item"><a href="https://fcmm.net" target="_blank"><img src="/img/logosPatros/fcmm.webp" alt="FCMM"></a></div>
        <div class="patro-item"><a href="https://www.patel.es/es/frivall.html" target="_blank"><img src="/img/logosPatros/frivall.webp" alt="FriVall"></a></div>
        <div class="patro-item"><a href="https://www.globalcaja.es" target="_blank"><img src="/img/logosPatros/globalcaja.webp" alt="Globalcaja"></a></div>
        <div class="patro-item"><a href="https://www.gt2i.es" target="_blank"><img src="/img/logosPatros/gt2i.webp" alt="GT2I"></a></div>
        <div class="patro-item"><a href="https://www.castillalamancha.es" target="_blank"><img src="/img/logosPatros/jccm-logo.webp" alt="Junta CLM"></a></div>
        <div class="patro-item"><a href="https://www.michelin.es" target="_blank"><img src="/img/logosPatros/logo-michelin.webp" alt="Michelin"></a></div>
        <div class="patro-item"><a href="https://www.rfeda.es" target="_blank"><img src="/img/logosPatros/rfeda-vertical.color.webp" alt="RFEDA"></a></div>
    </div>
</section>
